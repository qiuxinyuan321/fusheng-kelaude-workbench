{
  "name": "fusheng-kelaode-workbench",
  "version": "1.7.0",
  "description": "浮生氪劳德工作台 · 在自己的云服务器上运行官方 Claude Code CLI，提供对话、文件、终端与监控底座，内置可选多账号轮询和任务恢复插件。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "qiuxinyuan321",
  "homepage": "https://github.com/qiuxinyuan321/fusheng-kelaude-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiuxinyuan321/fusheng-kelaude-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/qiuxinyuan321/fusheng-kelaude-workbench/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "workbench",
    "self-hosted",
    "server-ops",
    "devops",
    "web-terminal",
    "monaco-editor",
    "sse"
  ],
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build-editor.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "set-password": "node scripts/set-password.mjs",
    "plugin:new": "node scripts/plugin-new.mjs",
    "plugin:pack": "node scripts/plugin-pack.mjs",
    "workshop:build": "node scripts/workshop-build.mjs",
    "test": "node --test test/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "marked": "^16.4.0",
    "monaco-editor": "0.57.0"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
